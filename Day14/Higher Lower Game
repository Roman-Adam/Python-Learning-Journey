def display_person(person, position):
    print(f"\n{position}: {person['name']}, a {person['description']}, from {person['country']}.")


score = 0
game_over = False

# First person
person_a = get_random_person()

while not game_over:

    # Get another person
    person_b = get_random_person()

    # Make sure B is different from A
    while person_b == person_a:
        person_b = get_random_person()

    print("\n" + "=" * 50)
    print("HIGHER LOWER GAME")
    print("=" * 50)

    display_person(person_a, "Compare A")
    print("\nVS")
    display_person(person_b, "Against B")

    print("\nWho has more followers?")
    answer = input("Type 'A' or 'B': ").lower()

    if answer == "a":
        guess = person_a
    elif answer == "b":
        guess = person_b
    else:
        print("Invalid answer!")
        break

    # Check the correct answer
    if person_a["follower_count"] > person_b["follower_count"]:
        correct_person = person_a
    else:
        correct_person = person_b

    if guess == correct_person:
        score += 1

        print("\nCorrect!")
        print(f"Your score is: {score}")

        # B becomes A for the next round
        person_a = person_b

    else:
        print("\nWrong answer!")
        print(f"Final score: {score}")
        game_over = True

print("\nGame Over!")
